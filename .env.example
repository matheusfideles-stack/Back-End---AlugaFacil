# Copie para .env e preencha. O arquivo .env NAO vai para o git.

# Senha do banco MySQL (alternativa: src/main/resources/application-local.yml)
DB_PASSWORD=

# Administrador inicial (cria os proprietarios). Criado na subida se ainda nao existir.
ADMIN_EMAIL=
ADMIN_SENHA=

# URL publica do site: aparece nas instrucoes dos e-mails de verificacao e de recuperacao de senha
APP_URL_BASE=http://localhost:8080
# Lembretes diarios (9h) de aluguel perto de vencer ou atrasado. Use false para desligar.
APP_LEMBRETES_ATIVO=true
# Posicao dos imoveis no mapa, pelo OpenStreetMap. Use false para nao consultar a internet.
APP_GEOCODIFICACAO_ATIVA=true

# E-mail do codigo de verificacao, da recuperacao de senha e do formulario de contato (veja docs/EMAIL.md).
# Sem SPRING_MAIL_HOST nada e enviado: o codigo so aparece no log. Em producao o sistema nao sobe sem ele.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
# Endereco que aparece como remetente (no Gmail, o mesmo da conta) e para onde vai o formulario de contato
MAIL_REMETENTE=
MAIL_SUPORTE=

# fake = aprova tudo localmente, sem rede | mercadopago = integracao real
PAGAMENTO_PROVIDER=mercadopago

# Credenciais do Mercado Pago (Suas integracoes > sua aplicacao > Credenciais)
# Sandbox usa TEST-..., producao usa APP_USR-...
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# URL publica do webhook. Deixe vazio em localhost: o Mercado Pago recusa a
# cobranca se a notification_url nao for acessivel de fora.
MP_NOTIFICATION_URL=

# Assinatura secreta do webhook (painel do Mercado Pago > Webhooks)
MP_WEBHOOK_SECRET=

# Perfil: deixe vazio para uso local; em producao use prod (veja docs/PRODUCAO.md).
SPRING_PROFILES_ACTIVE=

# Chave que assina o login (JWT). Aleatoria, com 32 caracteres ou mais. Em prod o sistema nao sobe sem ela.
JWT_SECRET=

# Pasta onde ficam as fotos dos imoveis (padrao: ./uploads)
UPLOADS_DIR=
